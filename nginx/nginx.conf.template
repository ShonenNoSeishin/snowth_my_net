# Rendered by entrypoint.sh (${PUBLIC_HTTPS_PORT} comes from SNOWTH_HTTPS_PORT).
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout combined;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 64k;          # the interface only ever receives two small forms

    # Everything in clear is redirected, keeping the port the reader typed.
    server {
        listen 80;
        server_name _;
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name _;

        ssl_certificate     /etc/nginx/certs/server.crt;
        ssl_certificate_key /etc/nginx/certs/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;
        ssl_session_cache   shared:SSL:1m;
        ssl_session_timeout 10m;

        # Honoured only once the certificate is trusted; harmless until then.
        add_header Strict-Transport-Security "max-age=31536000" always;

        location / {
            proxy_pass http://web:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # $remote_addr, not $proxy_add_x_forwarded_for: this front is the only proxy, so
            # it states who it is talking to and a reader cannot inject an address of their own
            # to dodge the failure limiter. Behind another proxy, chain them instead.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;   # makes the session cookie Secure
            proxy_read_timeout 120s;
        }
    }
}
