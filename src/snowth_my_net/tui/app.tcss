/* snowth_my_net terminal interface. Colors come from the active Textual theme. */

Screen {
    background: $background;
}

#topbar {
    dock: top;
    height: 1;
    background: $panel;
    padding: 0 1;
}

#brand {
    width: 1fr;
    color: $accent;
}

#runstatus {
    width: auto;
    color: $text-muted;
}

.banner-error {
    background: $error 30%;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 1 0 1;
}

#filter, #node-filter {
    margin-bottom: 1;
}

#devices, #runs, #nodes, #links, #neighbors {
    height: 1fr;
}

.empty {
    color: $text-muted;
    padding: 1 2;
}

.legend {
    color: $text-muted;
    height: 1;
    margin-top: 1;
}

/* device screen ------------------------------------------------------------------------ */

#identity {
    padding: 0 1;
}

.intro {
    background: $primary 15%;
    border-left: thick $primary;
    padding: 0 1;
    margin-bottom: 1;
}

.section {
    color: $accent;
    text-style: bold;
    margin: 1 0 0 0;
}

.form {
    grid-size: 3;
    grid-columns: 32 1fr 16;
    grid-rows: 1;
    grid-gutter: 1 2;
    height: auto;
    margin: 1 0;
}

.form Switch {
    width: auto;
    height: 1;
    border: none;
    padding: 0;
}

.source {
    text-align: right;
    padding-right: 2;
}

.form-buttons {
    height: auto;
    align-horizontal: right;
    margin: 1 0 2 0;
}

.form-buttons Button {
    margin-left: 2;
}

#tester {
    height: 1fr;
}

#presets-pane {
    width: 58;
    margin-right: 1;
}

#presets {
    height: 1fr;
}

#results-pane {
    width: 1fr;
}

#oid-bar {
    height: auto;
}

#oid {
    width: 1fr;
}

#oid-bar Input, #oid-bar Select, #oid-bar Button {
    margin-right: 1;
}

#oid-mode {
    width: 24;
}

#limit {
    width: 8;
}

#tester-status {
    margin: 1 0;
    height: auto;
}

#results, #last {
    height: 1fr;
}

#last-when {
    margin-bottom: 1;
}

/* dialogs ------------------------------------------------------------------------------ */

ModalScreen {
    align: center middle;
    background: $background 60%;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

.dialog.wide {
    width: 100;
}

.dialog.tall {
    height: 80%;
}

.dialog-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.dialog-text {
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 2;
}

.hint {
    color: $text-muted;
    margin-top: 1;
}

#collect-status {
    margin-bottom: 1;
}

#collect-log {
    height: 1fr;
    border: round $panel-lighten-2;
}

#explain-body {
    height: 1fr;
    border: round $panel-lighten-2;
    padding: 0 1;
}

.dialog.explain {
    width: 96%;
    height: 90%;
}
