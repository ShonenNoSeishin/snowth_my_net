# Copy to .env and adjust.

# Image tag built by "docker compose build".
SNOWTH_VERSION=latest

# The container runs as this user: make it the owner of ./data, ./output and ./secrets
# (e.g. the values of "id -u" and "id -g"), so that secrets can stay chmod 600 and outputs are
# readable on the host.
SNOWTH_UID=10001
SNOWTH_GID=10001

# Time zone used to interpret schedule: (outputs are always in UTC).
TZ=Europe/Brussels

# Run one collect when the container starts (true/false).
SNOWTH_COLLECT_ON_START=true

# A secret can also come from the environment (credentials: community_env / *_env), but files
# under ./secrets are preferred: they do not show up in "docker inspect".
# SNOWTH_V2C_COMMUNITY=
