# Copy to .env and uncomment what you want to change. Every line below shows the default that
# compose.yml uses when the variable is unset: uncommenting a line with the same value changes
# nothing, so you can keep the ones you actually override.

# --------------------------------------------------------------------------- compose.yml

# Image tag built by "docker compose build" and run by "docker compose up".
#SNOWTH_VERSION=latest

# The container runs as this user. Recommended: set both to the output of "id -u" and "id -g",
# so that the container can read ./secrets (chmod 600) and write ./data and ./output, and so
# that the files it produces stay yours on the host.
#SNOWTH_UID=10001
#SNOWTH_GID=10001

# Time zone used to interpret schedule: (every output stays in UTC).
#TZ=UTC

# Run one collect when the container starts, instead of waiting for the first scheduled one.
#SNOWTH_COLLECT_ON_START=true

# The web interface is reached through the nginx service, over TLS. These are its two host
# ports; the interface itself is not published in clear.
#SNOWTH_HTTPS_PORT=8443

# Plain HTTP, redirected to the address above. Keeping it lets an old bookmark still work.
#SNOWTH_HTTP_PORT=8080

# Names and addresses the self-signed certificate is made for, comma-separated. Put the name
# people type in their browser (and the IP, if they type one) so the certificate at least
# matches the address: "netdisco.example.net,192.0.2.10,localhost,127.0.0.1". The certificate
# is generated once, on the first start; delete the certs_web volume to have another one made.
#SNOWTH_TLS_HOSTS=localhost,127.0.0.1

# --------------------------------------------------------------------------- secrets

# Secrets are files: drop them in ./secrets (chmod 600), which is mounted whole and read-only on
# /run/secrets, and name them in the configuration ("community_file: community_office"). Adding
# one changes nothing here and nothing in compose.yml.
#
# A secret can also come from the environment (credentials: community_env / *_env, push tokens),
# but a file is preferred: it does not show up in "docker inspect". A variable used this way must
# also reach the container, through a compose.override.yml that adds it to "environment:".
#SNOWTH_V2C_COMMUNITY=

# --------------------------------------------------------------------------- set by the image

# These are baked into the image and match the volumes of compose.yml. Change them only if you
# change the mounts too, in a compose.override.yml.
#   SNOWTH_CONFIG=/etc/snowth_my_net/config.yml
#   SNOWTH_STATE_DIR=/var/lib/snowth_my_net
#   SNOWTH_OUTPUT_DIR=/output
#   SNOWTH_SECRETS_DIR=/run/secrets
#   SNOWTH_EXTENSIONS_DIR=/etc/snowth_my_net/extensions
